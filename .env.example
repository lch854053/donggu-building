# ─────────────────────────────────────────────────────────────
# 공공데이터포털(apis.data.go.kr) 서비스키 — 단일 키 통합
# ─────────────────────────────────────────────────────────────
# 검증(2026-07): 하나의 일반 인증키가 아래 서비스 모두에서 인증 통과함.
#   - BldRgstHubService (건축물대장)
#   - ArchPmsHubService (건축인허가)
#   - HsPmsHubService   (주택인허가)
#   - ShtRgstHubService (폐쇄말소대장)
#   - MtnChkHubService  (건축물유지점검 — 정기점검이력/점검기관)
#   - AptBasisInfoServiceV4 (K-APT 공동주택 기본정보)
# 따라서 보통 이 값 하나만 설정하면 됩니다 (디코딩된 키).
DATA_SERVICE_KEY=your_data_go_kr_service_key

# ── 레거시: 서비스별 개별 키 ──────────────────────────────────
# 이미 개별 키를 설정해 둔 배포도 호환됩니다 (DATA_SERVICE_KEY 보다 우선).
# 새 설정에서는 비워두셔도 됩니다.
# BLD_SERVICE_KEY=...
# ARCH_SERVICE_KEY=...
# HSPMS_SERVICE_KEY=...
# SHT_SERVICE_KEY=...
# MTNCHK_SERVICE_KEY=...
# APT_SERVICE_KEY=...

# ─────────────────────────────────────────────────────────────
# 별도 인증 체계 (위 단일 키로 통합 불가)
# ─────────────────────────────────────────────────────────────

# 오픈데이터(odcloud, api.odcloud.kr) — 공동주택 단지목록(aptid) + 동구 건축허가현황 폴백.
# 공공데이터포털과 다른 인증 체계라 DATA_SERVICE_KEY 로 동작하지 않음.
ODCLOUD_SERVICE_KEY=your_odcloud_service_key

# V-World — 좌표 → 필지(PNU) 변환 (빈집현황 행정동 매핑용),
#         상세카드 지도의 필지경계(연속지적도)·건물윤곽·속성(GIS건물통합정보 WFS)에 공용
VWORLD_KEY=your_vworld_service_key

# 행안부 도로명주소 API 키 — update-odcloud 스크립트에서 PNU 보강용
JUSO_CONFM_KEY=your_juso_confm_key

# 카카오 — 로컬 키워드 검색 API (공동주택명 보정용)
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# KOSIS(국가통계포털) — 통계 탭용 e-지방지표 수집 (update-stats 스크립트)
KOSIS_API_KEY=your_kosis_api_key

# SGIS(통계지리정보서비스) — 인구주택총조사 주택·거처 통계 (update-sgis-stats 스크립트)
# 서비스 ID와 보안 Key로 AccessToken을 발급하며, 인증정보는 브라우저에 사용하지 않습니다.
SGIS_CONSUMER_KEY=your_sgis_service_id
SGIS_CONSUMER_SECRET=your_sgis_security_key
